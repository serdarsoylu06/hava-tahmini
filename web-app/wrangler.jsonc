// Cloudflare yayın ayarı (Workers, durağan dosyalar). Sunucu kodu yoktur: "main" bilerek verilmedi,
// Cloudflare yalnızca "npm run build" çıktısını (dist/) dağıtır.
// "name" Cloudflare panelindeki Worker adıyla aynı olmak zorundadır.
{
  "name": "havalabss",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
